# Optionale Host-Port-Overrides für die lokale Entwicklung.
GARAGE_S3_PORT=3900
GARAGE_PUBLIC_PORT=8081
JENKINS_PORT=8080
DATENPORTAL_JENKINS_IMAGE=sogis/datenportal-jenkins:0.1.0
PLUGIN_SOURCE=auto
PLUGIN_VERSION=0.1.0-SNAPSHOT
PLUGIN_REPOSITORY_URL=https://jars.interlis.guru/snapshots

# GRETL-S3-Konfiguration im Jenkins-Container. Der Endpoint muss aus dem
# Compose-Netzwerk erreichbar sein; für Garage ist http://garage:3900 korrekt.
# DATENPORTAL_S3_ENDPOINT=http://garage:3900
# DATENPORTAL_S3_REGION=garage
# DATENPORTAL_S3_BUCKET=ch.so.daten
# DATENPORTAL_S3_ACL=private

# GARAGE_DEFAULT_ACCESS_KEY und GARAGE_DEFAULT_SECRET_KEY werden durch
# ./scripts/init.sh erzeugt und dürfen nicht committed werden.
