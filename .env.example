# Optionale Host-Port-Overrides für die lokale Entwicklung.
GARAGE_S3_PORT=3900
GARAGE_PUBLIC_PORT=8081
DATENPORTAL_JENKINS_IMAGE=sogis/datenportal-jenkins:0.1.0-3
DATENPORTAL_SODATA_IMAGE=sogis/datenportal-sodata:0.1.11
DATENPORTAL_DOCS_IMAGE=sogis/datenportal-dokumentation:0.1.18
# Nur --registry-only: Jenkins bezieht das Themenrepo selbst aus Git.
# THEMEN_REPO_URL=https://github.com/sogis/datenportal-themenrepo.git
# THEMEN_REPO_BRANCH=main
# DOCS_REPO_DIR=../datenportal-dokumentation
# THOTH_REPO_DIR=../thoth
# THOTH_JAR=/pfad/zu/thoth-biblios-all.jar
# PYTHON=/pfad/zu/python-mit-pyyaml
PLUGIN_SOURCE=auto
PLUGIN_VERSION=0.1.0-SNAPSHOT
PLUGIN_REPOSITORY_URL=https://jars.interlis.guru/snapshots

# GRETL-S3-Konfiguration im Jenkins-Container. Der Endpoint muss aus dem
# Compose-Netzwerk erreichbar sein; für Garage ist http://garage:3900 korrekt.
# DATENPORTAL_S3_ENDPOINT=http://garage:3900
# DATENPORTAL_S3_REGION=garage
# DATENPORTAL_S3_BUCKET=ch.so.daten
# DATENPORTAL_S3_ACL=private

# GARAGE_DEFAULT_ACCESS_KEY, GARAGE_DEFAULT_SECRET_KEY,
# GARAGE_BROWSER_ACCESS_KEY und GARAGE_BROWSER_SECRET_KEY werden durch
# ./scripts/init.sh erzeugt und dürfen nicht committed werden.

# Publikation ist im lokalen Stack ausdrücklich aktiviert; false erzeugt Vorschauen.
# DATENPORTAL_S3_PUBLISH=true
# DATENPORTAL_PUBLICATION_MANIFEST_URL=http://localhost:8081/ch.so.daten/current.json
# Default für den Portal-Reload im Compose-Netz:
# DATENPORTAL_PORTAL_RELOAD_URL=http://sodata:8080/admin/catalog/reload
# DATENPORTAL_PORTAL_RELOAD_TOKEN wird lokal von init.sh erzeugt und gilt für
# Jenkins und den Portal-Container gemeinsam. Vorhandene Werte bleiben erhalten.
# DATENPORTAL_BOOTSTRAP_USER / DATENPORTAL_BOOTSTRAP_PASSWORD können das lokale
# JCasC-Testkonto für Bootstrap-Aufrufe überschreiben; Secrets nicht committen.
