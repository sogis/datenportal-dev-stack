# Branch s3-aws: öffentlich lesender Betrieb mit Sodata und APISIX.
# .env ist optional. Bestehende lokale .env und Secrets bleiben erhalten.
DATENPORTAL_SODATA_IMAGE=sogis/datenportal-sodata:0.1.20
# Historischer Name, jetzt nur noch APISIX-Hostport und Listener-Port.
GARAGE_PUBLIC_PORT=8081
DATENPORTAL_CATALOG_HTTP_URL=https://s3.eu-central-1.amazonaws.com/ch.so.daten-test/current.json
DATENPORTAL_CATALOG_DOWNLOAD_URL=https://s3.eu-central-1.amazonaws.com/ch.so.daten-test

# Optional für --local-sodata; Dockerfile und Buildlogik bleiben im Schwesterrepo.
# SODATA_REPO_DIR=../datenportal-sodata
# Optionaler interner Reload-Token; ohne Token sind Reload/Status deaktiviert.
# DATENPORTAL_PORTAL_RELOAD_TOKEN=
# AWS-/Garage-Zugangsdaten werden für diesen Lesebetrieb nicht benötigt.
